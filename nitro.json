{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitroocr"],
  "ignorePaths": ["**/node_modules"],
  "ios": {
    "iosModuleName": "VisionCameraNitroOcr"
  },
  "android": {
    "androidNamespace": ["nitroocr"],
    "androidCxxLibName": "NitroOcr"
  },
  "autolinking": {
    "NitroOcr": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroOcr"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroOcr"
      }
    }
  }
}
