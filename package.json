{
  "name": "@kpaterson/vision-camera-nitro-ocr",
  "version": "0.1.6",
  "description": "Nitro Modules OCR plugin for react-native-vision-camera v5 (MLKit on iOS+Android)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "ios",
    "android",
    "nitrogen/generated",
    "nitro.json",
    "react-native.config.js",
    "VisionCameraNitroOcr.podspec",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf lib && tsc",
    "clean": "rm -rf lib android/build android/.cxx ios/build",
    "nitrogen": "nitrogen",
    "prepack": "yarn build"
  },
  "keywords": [
    "react-native",
    "vision-camera",
    "ocr",
    "text-recognition",
    "mlkit",
    "nitro-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinranks/vision-camera-nitro-ocr.git"
  },
  "author": "Kevin P <contact@kpaterson.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-vision-camera": ">=5.0.0",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "@types/react": "19.1.1",
    "@types/react-native": "0.72.0",
    "nitrogen": "latest",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-nitro-modules": "^0.35.0",
    "react-native-vision-camera": "^5.0.4",
    "typescript": "^5.4.0"
  }
}
